{
  "name": "patzer",
  "version": "8.0.0",
  "private": true,
  "description": "Patzer — a local-first, human-like chess trainer. Play a bot that plays like a person, review your own games and learn from your own mistakes. On-device, offline, AGPL-3.0.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/SikamikanikoBG/patzer",
  "repository": {
    "type": "git",
    "url": "https://github.com/SikamikanikoBG/patzer.git"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "preview": "npm run preview -w web",
    "typecheck": "tsc -b web --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "cap:android:apk": "cd android && ./gradlew assembleRelease",
    "build:android": "npm run build && npm run cap:sync && npm run cap:android:apk"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@testing-library/react": "^14.3.1",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.11"
  }
}
